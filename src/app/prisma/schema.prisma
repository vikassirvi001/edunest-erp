generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  editor
}

enum PurchaseProvider {
  razorpay
  stripe
}

enum PurchaseStatus {
  pending
  paid
  failed
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(editor)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  articles     Article[]
}

model Category {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  iconUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
}

model Article {
  id                  String    @id @default(cuid())
  title               String
  slug                String    @unique
  categoryId          String
  category            Category  @relation(fields: [categoryId], references: [id])
  authorId            String
  author              User      @relation(fields: [authorId], references: [id])
  excerpt             String
  contentMarkdown     String    @db.Text
  tags                String[]
  views               Int       @default(0)
  isPublished         Boolean   @default(false)
  seoMetaTitle        String?
  seoMetaDescription  String?
  seoKeywords         String[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  pdfAssets           PdfAsset[]
  premiumPurchases    PremiumPurchase[]

  @@index([categoryId])
  @@index([authorId])
  @@index([isPublished])
}

model PdfAsset {
  id            String   @id @default(cuid())
  articleId     String
  article       Article  @relation(fields: [articleId], references: [id])
  s3KeyFree     String
  s3KeyPremium  String?
  downloadId    String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([articleId])
}

model AdSlot {
  id         String   @id @default(cuid())
  slotName   String   @unique
  adClient   String
  adSlotId   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Anonymous ad-free PDF purchase. Intentionally has NO relation to User —
// purchases are keyed solely by the payment provider's session id, so a
// reader never needs an account to buy the watermark-free PDF.
model PremiumPurchase {
  id                     String            @id @default(cuid())
  articleId              String
  article                Article           @relation(fields: [articleId], references: [id])
  provider               PurchaseProvider
  providerSessionId      String            @unique
  amount                 Int
  status                 PurchaseStatus    @default(pending)
  unwatermarkedLinkToken String?           @unique
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([articleId])
}
